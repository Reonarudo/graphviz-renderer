{
  "name": "@reonarudo/graphviz-renderer",
  "version": "0.1.0",
  "description": "Render Graphviz (DOT) graphs to safe, inline-ready SVG in Node",
  "keywords": [
    "graphviz",
    "dot",
    "diagram",
    "svg",
    "markdown",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Reonarudo/graphviz-renderer.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "licenses",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "tsc --noEmit -p tsconfig.json",
    "compile": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:packed": "node scripts/test-packed.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
